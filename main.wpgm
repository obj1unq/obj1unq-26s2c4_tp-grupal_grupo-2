import vida.*
import randomizer.*
import wollok.game.*
import personajes.*
import direcciones.*
import mapa.*
import cosasEntorno.*



program juego {
    
    nivel.configurarTablero()
    nivel.dibujarMapa()
    //game.addVisual(guerrero)
    //game.addVisual(goblin)
    
    const animacionMovimientoGuerrero = game.tick(100, { guerrero.posicionDeMira().siguienteFrame(guerrero)}, false)

    const aparicionGoblins = game.tick(10000, {generadorGoblins.generar(0, guerrero)}, false)
    const animacionMovimientoGoblins = game.tick(100, {generadorGoblins.goblins().forEach({ goblin => goblin.posicionDeMira().siguienteFrame(goblin)})}, false)
    const movimientoGoblins = game.tick(1500, {generadorGoblins.goblins().forEach({ goblin => goblin.perseguirGuerrero()})}, false)

    const manzanasAleatorias = game.tick(22500, { generadorDeManzanas.generar(0, guerrero) }, false)

    keyboard.e().onPressDo({ guerrero.interactuar() })
    keyboard.t().onPressDo({ guerrero.transformar() })

    keyboard.left().onPressDo({ guerrero.mover(izquierda) })
    keyboard.right().onPressDo({ guerrero.mover(derecha) })
    keyboard.up().onPressDo({ guerrero.mover(arriba) })
    keyboard.down().onPressDo({ guerrero.mover(abajo) })

    keyboard.space().onPressDo({ guerrero.atacar() })
    
    animacionMovimientoGuerrero.start()

    animacionMovimientoGoblins.start()
    movimientoGoblins.start()
    
    manzanasAleatorias.start()
    aparicionGoblins.start()

    game.start()
}