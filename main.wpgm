import wollok.game.*
import personajes.*
import direcciones.*

program juego {

    game.addVisual(guerrero)
    game.addVisual(goblin)

    const animacionMovimientoGoblin   = game.tick(100, {goblin.posicionDeMira().siguienteFrame(goblin.posicionDeMira().maxFramesMov())}, false)
    const animacionMovimientoGuerrero = game.tick(100, {guerrero.posicionDeMira().siguienteFrame(guerrero.posicionDeMira().maxFramesMov())}, false)

    keyboard.left().onPressDo({ guerrero.mover(moverIzquierda) })
    keyboard.right().onPressDo({ guerrero.mover(moverDerecha) })
    keyboard.up().onPressDo({ guerrero.mover(moverArriba) })
    keyboard.down().onPressDo({ guerrero.mover(moverAbajo) })

    keyboard.space().onPressDo({ guerrero.posicionDeMira().atacar() })
    
    animacionMovimientoGuerrero.start()
    animacionMovimientoGoblin.start()

    game.start()
}